# Values for the seed script only (`npm run seed`). The app does not need
# this file, and none of these values go to Vercel.
#
# Copy this file to `.env.local` (which Git ignores) and fill it in.
# Never commit `.env.local`, and never paste these values anywhere public.

# Supabase > Project Settings > API Keys > the SECRET key (also called the
# service role key). It bypasses every access rule, so only this local
# script may use it.
SUPABASE_SERVICE_ROLE_KEY=

# The demo account the seed creates and fills. Pick an address that is not
# already an account, and a password of at least 8 characters.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Optional: the name shown in the app. Defaults to "Alex Chen".
SEED_USER_NAME=
